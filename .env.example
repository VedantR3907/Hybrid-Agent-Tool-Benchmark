OLLAMA_API_KEY=your_api_key_here
OLLAMA_API_KEY_SECOND=your_second_api_key_here
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=glm-5:cloud
# Optional: comma-separated list to benchmark across multiple models.
# When set, overrides OLLAMA_MODEL for `python -m app.tasks.runner` runs.
OLLAMA_MODELS=
OLLAMA_TEMPERATURE=0
OLLAMA_MAX_TOKENS=2048
OLLAMA_TIMEOUT_SECONDS=60
BENCHMARK_MAX_TURNS=8
BENCHMARK_LLM_CALL_PAUSE_SECONDS=5
BENCHMARK_OUTPUT_CHAR_LIMIT=4000
BENCHMARK_OUTPUT_LINE_LIMIT=120

BENCHMARK_COMMAND_TIMEOUT_SECONDS=20

